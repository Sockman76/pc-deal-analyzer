<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>PC Deal Analyzer</title>

<style>

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
  background: #090b10;
  color: white;
}

/* HEADER */

header {
  border-bottom: 1px solid #20242e;
  background: #0d1017;
}

.nav {
  max-width: 1050px;
  margin: auto;
  padding: 18px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  font-size: 20px;
  font-weight: 800;
}

.logo span {
  color: #6c8cff;
}

.badge {
  font-size: 12px;
  background: #1b2030;
  padding: 7px 11px;
  border-radius: 20px;
  color: #aeb9d8;
}

/* HERO */

.hero {
  max-width: 850px;
  margin: auto;
  text-align: center;
  padding: 70px 20px 35px;
}

.hero h1 {
  font-size: clamp(38px, 7vw, 64px);
  line-height: 1.05;
  margin: 0;
}

.hero h1 span {
  color: #6c8cff;
}

.hero p {
  color: #9ba3b5;
  font-size: 18px;
  line-height: 1.6;
  max-width: 650px;
  margin: 20px auto;
}

/* MAIN */

.container {
  max-width: 750px;
  margin: auto;
  padding: 20px 20px 80px;
}

.card {
  background: #11151d;
  border: 1px solid #242a36;
  border-radius: 18px;
  padding: 25px;
  box-shadow: 0 15px 50px rgba(0,0,0,.25);
}

.card h2 {
  margin-top: 0;
  font-size: 23px;
}

.subtitle {
  color: #8f98aa;
  font-size: 14px;
  margin-bottom: 25px;
}

/* FORM */

label {
  display: block;
  margin-bottom: 7px;
  font-weight: 600;
  font-size: 14px;
}

input, select {
  width: 100%;
  padding: 14px;
  margin-bottom: 18px;

  background: #090c12;
  color: white;

  border: 1px solid #303747;
  border-radius: 10px;

  font-size: 16px;
  outline: none;
}

input:focus, select:focus {
  border-color: #6c8cff;
}

.row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
}

button {
  width: 100%;
  border: none;
  padding: 16px;

  background: #5978ff;
  color: white;

  border-radius: 11px;
  font-size: 16px;
  font-weight: 700;

  cursor: pointer;
}

button:active {
  transform: scale(.99);
}

/* RESULT */

#result {
  display: none;
  margin-top: 25px;
  padding-top: 25px;
  border-top: 1px solid #292f3a;
}

.score {
  font-size: 42px;
  font-weight: 800;
}

.verdict {
  font-size: 19px;
  margin-top: 5px;
}

.resultText {
  color: #a6adba;
  margin-top: 15px;
  line-height: 1.6;
}

.warning {
  margin-top: 18px;
  background: #171b25;
  padding: 15px;
  border-radius: 10px;
  color: #c7ccda;
}

/* FEATURES */

.features {
  max-width: 900px;
  margin: 30px auto 80px;
  padding: 0 20px;

  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
}

.feature {
  background: #10141c;
  border: 1px solid #222834;
  border-radius: 15px;
  padding: 20px;
}

.featureIcon {
  font-size: 25px;
}

.feature h3 {
  margin-bottom: 7px;
}

.feature p {
  margin: 0;
  color: #8e97a8;
  line-height: 1.5;
  font-size: 14px;
}

/* FOOTER */

footer {
  text-align: center;
  color: #606979;
  padding: 30px;
  border-top: 1px solid #1c2028;
  font-size: 13px;
}

/* MOBILE */

@media(max-width: 600px) {

  .hero {
    padding-top: 50px;
  }

  .row {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .features {
    grid-template-columns: 1fr;
  }

}

</style>
</head>

<body>

<header>

<div class="nav">

<div class="logo">
PC<span>Deal</span>
</div>

<div class="badge">
BETA
</div>

</div>

</header>


<section class="hero">

<h1>
Stop overpaying for
<span>used PCs.</span>
</h1>

<p>
Enter the components and asking price of a used gaming PC.
We'll help you figure out whether you're looking at a bargain
or a bad deal.
</p>

</section>


<main class="container">

<div class="card">

<h2>Analyze a PC</h2>

<div class="subtitle">
Enter as much information as you know.
</div>


<label>CPU</label>

<input
id="cpu"
placeholder="e.g. Ryzen 5 5600X"
>


<label>GPU</label>

<input
id="gpu"
placeholder="e.g. RTX 3070"
>


<div class="row">

<div>

<label>Memory</label>

<select id="ram">

<option value="">Select RAM</option>
<option>8GB</option>
<option>16GB</option>
<option>32GB</option>
<option>64GB+</option>

</select>

</div>


<div>

<label>Storage</label>

<select id="storage">

<option value="">Select storage</option>
<option>256GB SSD</option>
<option>500GB SSD</option>
<option>1TB SSD</option>
<option>2TB SSD</option>
<option>HDD Only</option>

</select>

</div>

</div>


<div class="row">

<div>

<label>Asking Price</label>

<input
id="price"
type="number"
placeholder="e.g. 850"
>

</div>


<div>

<label>Currency</label>

<select id="currency">

<option>CAD</option>
<option>USD</option>

</select>

</div>

</div>


<button onclick="analyzeDeal()">
Analyze Deal →
</button>


<div id="result">

<div id="score" class="score"></div>

<div id="verdict" class="verdict"></div>

<div id="resultText" class="resultText"></div>

<div class="warning">

<strong>Before buying:</strong><br><br>

Always test a used PC in person when possible.
Check temperatures, storage health, GPU stability,
and the exact power supply model.

</div>

</div>

</div>

</main>


<section class="features">

<div class="feature">

<div class="featureIcon">💰</div>

<h3>Deal Rating</h3>

<p>
Quickly see whether the asking price looks reasonable.
</p>

</div>


<div class="feature">

<div class="featureIcon">🎮</div>

<h3>Performance</h3>

<p>
Understand what kind of gaming experience the hardware can provide.
</p>

</div>


<div class="feature">

<div class="featureIcon">🔧</div>

<h3>Upgrade Check</h3>

<p>
Spot potential weaknesses before spending your money.
</p>

</div>

</section>


<footer>

PCDeal • Built for smarter PC buying

</footer>


<script>

function analyzeDeal() {

const cpu =
document.getElementById("cpu").value.trim();

const gpu =
document.getElementById("gpu").value.trim();

const price =
Number(document.getElementById("price").value);

const currency =
document.getElementById("currency").value;

const result =
document.getElementById("result");

const score =
document.getElementById("score");

const verdict =
document.getElementById("verdict");

const text =
document.getElementById("resultText");


if (!cpu || !gpu || !price) {

alert(
"Please enter the CPU, GPU and asking price."
);

return;

}


/*
Temporary scoring system.

Next version will calculate values
using the actual CPU and GPU.
*/

let dealScore;

if (price <= 500) {

dealScore = 90;

} else if (price <= 800) {

dealScore = 80;

} else if (price <= 1200) {

dealScore = 70;

} else if (price <= 1700) {

dealScore = 60;

} else {

dealScore = 50;

}


score.innerHTML =
dealScore + "/100";


if (dealScore >= 85) {

verdict.innerHTML =
"🔥 Potentially excellent deal";

} else if (dealScore >= 70) {

verdict.innerHTML =
"✅ Potentially good deal";

} else if (dealScore >= 60) {

verdict.innerHTML =
"🟡 Worth investigating";

} else {

verdict.innerHTML =
"⚠️ Price needs a closer look";

}


text.innerHTML =

"<strong>" +
cpu +
"</strong> paired with a <strong>" +
gpu +
"</strong> for <strong>$" +
price.toLocaleString() +
" " +
currency +
"</strong>.<br><br>" +

"This is currently an early estimate. Hardware-based market valuation is coming in the next version.";


result.style.display =
"block";


result.scrollIntoView({
behavior: "smooth",
block: "nearest"
});

}

</script>

</body>
</html>
